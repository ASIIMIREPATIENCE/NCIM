
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap");

:root {
  font-family: "Inter", sans-serif;
  color: #252525;
  background: #f7f2e8;
  --green: #173f35;
  --gold: #c9a23f;
  --ivory: #f7f2e8;
  --charcoal: #252525;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
  padding: 18px 5%;
  background: var(--white);
  border-bottom: 1px solid #e9e1d1;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--green);
  color: var(--gold);
  font-size: 24px;
  font-weight: 800;
}

.brand strong,
.site-footer strong {
  display: block;
  font-family: "Montserrat", sans-serif;
  font-size: 22px;
  color: var(--green);
}

.brand small {
  display: block;
  margin-top: 4px;
  font-size: 10px;
}

.main-nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}

.nav-link {
  font-size: 13px;
  font-weight: 600;
}

.nav-link:hover,
.nav-link.active {
  color: #967018;
}

.donate-button {
  padding: 12px 20px;
  border-radius: 5px;
  background: var(--gold);
  color: var(--charcoal);
  font-weight: 700;
}

.site-footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 24px;
  padding: 40px 5%;
  background: var(--green);
  color: var(--white);
}

.site-footer strong {
  color: var(--gold);
}

.site-footer p {
  max-width: 360px;
  font-size: 13px;
  line-height: 1.7;
}

@media (max-width: 600px) {
  .site-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .main-nav {
    gap: 12px;
  }

  .site-footer {
    flex-direction: column;
  }
}


/* HOME PAGE */

.home-page {
  background: var(--ivory);
}

.section-padding {
  padding: 88px 7%;
}

.eyebrow {
  display: inline-block;
  color: #987019;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  line-height: 1.7;
}

.home-hero {
  display: grid;
  grid-template-columns: 1fr 0.9fr;
  align-items: center;
  gap: 55px;
  padding: 75px 7%;
  min-height: 600px;
}

.hero-content h1 {
  margin: 20px 0;
  color: var(--green);
  font-size: clamp(42px, 5vw, 72px);
  line-height: 1.08;
  letter-spacing: -2.5px;
}

.hero-content h1 span {
  color: #a87e1e;
}

.hero-content > p,
.section-heading > p,
.purpose-content > p,
.stories-copy > p {
  color: #565b56;
  font-size: 15px;
  line-height: 1.9;
}

.hero-content > p {
  max-width: 550px;
  font-size: 17px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 14px 21px;
  border: 1px solid transparent;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
  transition: transform 0.2s ease, background 0.2s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-gold {
  background: var(--gold);
  color: var(--charcoal);
}

.button-outline {
  border-color: var(--green);
  color: var(--green);
}

.button-dark {
  background: var(--green);
  color: var(--white);
}

.button-light {
  background: var(--white);
  color: var(--green);
}

.hero-note {
  margin-top: 32px;
  padding-left: 14px;
  border-left: 3px solid var(--gold);
  color: #6a6a60;
  font-size: 12px;
  line-height: 1.8;
}

.hero-image {
  position: relative;
  min-height: 430px;
}

.hero-image > img {
  width: 100%;
  height: 430px;
  object-fit: cover;
  border-radius: 5px;
}

.hero-image-caption {
  position: absolute;
  right: -18px;
  bottom: 25px;
  left: 22px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px;
  background: white;
  box-shadow: 0 12px 35px #173f3518;
}

.caption-mark {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--ivory);
  color: #987019;
  font-size: 23px;
}

.hero-image-caption strong {
  color: var(--green);
  font-size: 14px;
}

.hero-image-caption p {
  margin: 6px 0 0;
  color: #6a6a60;
  font-size: 12px;
  line-height: 1.6;
}

.home-intro {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 65px;
  background: white;
}

.section-heading h2,
.purpose-content h2,
.stories-copy h2,
.involve-section h2 {
  margin: 12px 0 18px;
  color: var(--green);
  font-size: clamp(28px, 3vw, 42px);
  line-height: 1.2;
  letter-spacing: -1px;
}

.intro-content > p {
  margin-top: 0;
  color: #565b56;
  font-size: 15px;
  line-height: 1.9;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-top: 12px;
  color: #8d6815;
  font-size: 13px;
  font-weight: 800;
}

.text-link span {
  transition: transform 0.2s ease;
}

.text-link:hover span {
  transform: translateX(4px);
}

.section-topline {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
  margin-bottom: 34px;
}

.section-topline .section-heading {
  max-width: 650px;
}

.section-topline .section-heading h2 {
  margin-bottom: 10px;
}

.section-topline .section-heading > p {
  margin-bottom: 0;
}

.section-topline > .text-link {
  flex-shrink: 0;
  margin-bottom: 7px;
}

.programme-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.programme-card {
  overflow: hidden;
  background: white;
  border: 1px solid #e8e1d3;
  border-radius: 5px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.programme-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px #173f3510;
}

.programme-image {
  position: relative;
  height: 205px;
}

.programme-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.programme-number {
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 8px 10px;
  background: var(--gold);
  color: var(--charcoal);
  font-size: 12px;
  font-weight: 800;
}

.programme-body {
  padding: 23px 19px;
}

.programme-category {
  color: #8d6815;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.programme-body h3,
.activity-card h3 {
  color: var(--green);
  font-size: 18px;
  line-height: 1.45;
}

.programme-body p,
.activity-card p {
  color: #62655f;
  font-size: 13px;
  line-height: 1.85;
}

.programme-body .text-link {
  font-size: 12px;
}

.home-purpose {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #eae5d8;
}

.purpose-image {
  min-height: 470px;
}

.purpose-image img {
  width: 100%;
  height: 100%;
  min-height: 470px;
  object-fit: cover;
}

.purpose-content {
  align-self: center;
  padding: 65px 10%;
}

.purpose-content h2 {
  max-width: 480px;
}

.purpose-content .button {
  margin-top: 17px;
}

.activities-section {
  background: white;
}

.activity-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.activity-card {
  padding: 30px;
  border: 1px solid #e8e1d3;
  background: var(--ivory);
}

.activity-icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #e9dfc6;
  color: #8d6815;
  font-size: 24px;
}

.activity-card h3 {
  margin-top: 22px;
}

.stories-section {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  align-items: center;
  gap: 65px;
}

.stories-copy .button {
  margin-top: 17px;
}

.stories-image img {
  width: 100%;
  height: 390px;
  object-fit: cover;
  border-radius: 5px;
}

.involve-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;
  padding: 65px 7%;
  background: var(--green);
  color: white;
}

.involve-section .eyebrow {
  color: var(--gold);
}

.involve-section h2 {
  margin-bottom: 10px;
  color: white;
}

.involve-section p {
  max-width: 560px;
  color: #e2e8e2;
  font-size: 14px;
  line-height: 1.9;
}

.involve-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

/* Responsive layouts */

@media (max-width: 1100px) {
  .home-hero {
    gap: 30px;
    padding-right: 5%;
    padding-left: 5%;
  }

  .programme-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .programme-image {
    height: 240px;
  }

  .section-padding {
    padding: 70px 5%;
  }
}

@media (max-width: 700px) {
  .home-hero,
  .home-intro,
  .home-purpose,
  .stories-section {
    grid-template-columns: 1fr;
  }

  .home-hero {
    padding: 55px 6%;
  }

  .hero-content h1 {
    font-size: clamp(38px, 10vw, 58px);
    letter-spacing: -1.5px;
  }

  .hero-image,
  .hero-image > img {
    min-height: 320px;
    height: 320px;
  }

  .hero-image-caption {
    right: 10px;
    left: 10px;
    bottom: 12px;
  }

  .home-intro {
    gap: 20px;
  }

  .section-topline {
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }

  .programme-grid,
  .activity-grid {
    grid-template-columns: 1fr;
  }

  .programme-image {
    height: 240px;
  }

  .purpose-image,
  .purpose-image img {
    min-height: 300px;
    height: 300px;
  }

  .purpose-content {
    padding: 50px 6%;
  }

  .stories-image img {
    height: 300px;
  }

  .involve-section {
    align-items: flex-start;
    flex-direction: column;
    padding: 50px 6%;
  }
}

```css
/* Ugandan-themed homepage additions */

.home-hero {
  background:
    linear-gradient(110deg, rgba(23, 63, 53, 0.97), rgba(23, 63, 53, 0.88));
}

.home-hero .hero-content h1 span {
  color: var(--gold);
}

.hero-image {
  position: relative;
  overflow: hidden;
  border-radius: 18px;
}

.hero-image img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 420px;
  object-fit: cover;
  object-position: center;
}

.hero-image-caption {
  position: absolute;
  right: 16px;
  bottom: 16px;
  left: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 18px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.94);
  color: var(--charcoal);
}

.hero-image-caption p {
  margin: 5px 0 0;
  font-size: 0.9rem;
}

.caption-mark {
  color: var(--gold);
  font-size: 1.7rem;
}

.programme-image {
  position: relative;
  overflow: hidden;
  background: #e6e0d2;
}

.programme-image img {
  display: block;
  width: 100%;
  height: 240px;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.programme-card:hover .programme-image img {
  transform: scale(1.04);
}

.purpose-image img,
.stories-image img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 360px;
  object-fit: cover;
}

.activity-feature-image {
  position: relative;
  overflow: hidden;
  margin: 28px 0;
  border-radius: 16px;
  background: #e6e0d2;
}

.activity-feature-image img {
  display: block;
  width: 100%;
  height: 340px;
  object-fit: cover;
}

.activity-feature-caption {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20px 24px;
  color: white;
  font-weight: 700;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
}

@media (max-width: 768px) {
  .hero-image img {
    min-height: 300px;
  }

  .programme-image img {
    height: 220px;
  }

  .purpose-image img,
  .stories-image img {
    min-height: 280px;
  }

  .activity-feature-image img {
    height: 240px;
  }
}


/* ABOUT NCIM PAGE */

.about-hero {
  display: grid;
  grid-template-columns: 1fr 0.9fr;
  align-items: center;
  gap: 48px;
  padding: 76px 7%;
  background: var(--ivory);
}

.about-hero-copy h1 {
  margin: 18px 0;
  color: var(--green);
  font-family: "Montserrat", sans-serif;
  font-size: clamp(2.5rem, 4.5vw, 4.5rem);
  line-height: 1.12;
}

.about-hero-copy h1 span {
  color: var(--gold);
}

.about-hero-copy > p {
  max-width: 560px;
  margin-bottom: 28px;
  line-height: 1.8;
}

.about-hero-image img,
.about-purpose-image img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 380px;
  object-fit: cover;
  border-radius: 18px;
}

.about-story {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  background: var(--white);
}

.about-story-heading h2,
.about-purpose-copy h2,
.about-accountability h2 {
  margin-top: 14px;
  color: var(--green);
  font-family: "Montserrat", sans-serif;
  font-size: clamp(1.8rem, 3vw, 3rem);
  line-height: 1.25;
}

.about-story-copy p,
.about-purpose-copy p,
.about-accountability p {
  margin-bottom: 18px;
  line-height: 1.8;
}

.about-purpose-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 56px;
  padding: 64px 7%;
  background: #eee7d8;
}

.purpose-links {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
  margin-top: 24px;
}

.about-vision {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.vision-card {
  padding: 36px;
  border-radius: 16px;
  background: #eee7d8;
}

.vision-card h2 {
  margin: 18px 0 12px;
  color: var(--green);
  font-family: "Montserrat", sans-serif;
}

.vision-card p {
  line-height: 1.8;
}

.vision-card-dark {
  background: var(--green);
  color: var(--white);
}

.vision-card-dark h2 {
  color: var(--white);
}

.vision-card-dark p {
  color: #f1eadc;
}

.about-values {
  background: var(--white);
}

.about-values .section-heading {
  max-width: 720px;
  margin-bottom: 32px;
}

.about-values .section-heading p,
.about-leadership .section-heading p {
  line-height: 1.8;
}

.about-values-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.about-value-card {
  padding: 26px 22px;
  border: 1px solid #e8e1d4;
  border-radius: 14px;
  background: var(--ivory);
}

.value-number {
  color: var(--gold);
  font-weight: 800;
}

.about-value-card h3 {
  margin: 18px 0 10px;
  color: var(--green);
  font-family: "Montserrat", sans-serif;
}

.about-value-card p {
  line-height: 1.7;
}

.about-leadership {
  background: var(--ivory);
}

.about-leadership .section-heading {
  max-width: 720px;
  margin-bottom: 28px;
}

.leadership-placeholder {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 30px;
  border: 1px dashed #c9a23f;
  border-radius: 16px;
  background: var(--white);
}

.leadership-placeholder-icon {
  display: grid;
  flex-shrink: 0;
  width: 88px;
  height: 88px;
  place-items: center;
  border-radius: 50%;
  background: var(--green);
  color: var(--gold);
  font-family: "Montserrat", sans-serif;
  font-weight: 800;
}

.leadership-placeholder h3 {
  margin-bottom: 8px;
  color: var(--green);
}

.leadership-placeholder p {
  margin: 0;
  line-height: 1.7;
}

.about-accountability {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  background: var(--white);
}

.about-accountability > div {
  max-width: 760px;
}

.about-cta {
  padding: 64px 7%;
  background: var(--green);
  color: var(--white);
  text-align: center;
}

.about-cta h2 {
  margin: 16px 0;
  font-family: "Montserrat", sans-serif;
  font-size: clamp(2rem, 3.5vw, 3.3rem);
}

.about-cta > p {
  max-width: 650px;
  margin: 0 auto 26px;
  line-height: 1.8;
}

.about-cta .hero-actions {
  justify-content: center;
}

@media (max-width: 900px) {
  .about-hero,
  .about-story,
  .about-purpose-section {
    grid-template-columns: 1fr;
  }

  .about-values-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .about-hero {
    padding: 48px 6%;
  }

  .about-vision,
  .about-values-grid {
    grid-template-columns: 1fr;
  }

  .about-accountability {
    align-items: flex-start;
    flex-direction: column;
  }

  .leadership-placeholder {
    align-items: flex-start;
    flex-direction: column;
  }
}


/* =========================================
   ABOUT NCIM — EDITORIAL PAGE DESIGN
   ========================================= */

.about-page {
  background: var(--ivory);
}

.about-banner {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  min-height: 510px;
  background: var(--green);
  color: var(--white);
}

.about-banner-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 68px 9%;
}

.about-banner .eyebrow {
  color: var(--gold);
}

.about-banner h1 {
  margin: 22px 0;
  font-family: "Montserrat", sans-serif;
  font-size: clamp(2.5rem, 4vw, 4.25rem);
  line-height: 1.12;
  letter-spacing: -0.045em;
}

.about-banner h1 span {
  display: block;
  margin-top: 8px;
  color: var(--gold);
}

.about-banner-content > p {
  max-width: 520px;
  margin-bottom: 28px;
  color: #f2eee5;
  line-height: 1.85;
}

.about-banner-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 22px;
}

.about-text-link {
  color: white;
  font-weight: 600;
  text-decoration: none;
}

.about-text-link span {
  margin-left: 6px;
  color: var(--gold);
}

.about-banner-image {
  position: relative;
  min-height: 430px;
  overflow: hidden;
  background: #d9d0bd;
}

.about-banner-image img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.about-image-label {
  position: absolute;
  right: 22px;
  bottom: 22px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px 18px;
  background: rgba(23, 63, 53, 0.94);
  color: white;
  font-size: 0.9rem;
  font-weight: 600;
}

.about-image-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--gold);
}

/* Story */

.about-story {
  display: grid;
  grid-template-columns: 0.75fr 1.25fr;
  gap: 70px;
  padding-top: 90px;
  padding-bottom: 90px;
  background: white;
}

.about-section-label {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
}

.about-section-number {
  margin-top: 45px;
  color: #e5ddce;
  font-family: "Montserrat", sans-serif;
  font-size: clamp(4rem, 9vw, 8rem);
  font-weight: 800;
  line-height: 1;
}

.about-story-content h2,
.about-purpose-intro h2,
.about-approach-content h2,
.about-values-heading h2,
.about-leadership-heading h2,
.about-accountability h2 {
  margin: 16px 0 22px;
  color: var(--green);
  font-family: "Montserrat", sans-serif;
  font-size: clamp(1.9rem, 3.2vw, 3.15rem);
  line-height: 1.24;
  letter-spacing: -0.035em;
}

.about-story-content p,
.about-purpose-intro p,
.about-approach-content p,
.about-values-heading p,
.about-leadership-heading > p,
.about-accountability p {
  line-height: 1.9;
}

.about-story-content p {
  margin-bottom: 18px;
}

.about-inline-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
  color: var(--green);
  font-weight: 700;
  text-decoration: none;
}

.about-inline-link span {
  color: #a17c22;
  transition: transform 0.2s ease;
}

.about-inline-link:hover span {
  transform: translate(3px, -3px);
}

/* Vision and mission */

.about-purpose {
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  align-items: center;
  gap: 55px;
  padding: 80px 7%;
  background: #eee7d8;
}

.about-purpose-intro > p {
  max-width: 440px;
}

.about-purpose-panels {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.about-purpose-panel {
  position: relative;
  min-height: 280px;
  padding: 30px 26px;
  border-top: 4px solid var(--gold);
  background: white;
}

.about-panel-number {
  color: #94701d;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.about-panel-icon {
  margin-top: 22px;
  color: var(--gold);
  font-size: 2rem;
}

.about-purpose-panel h3 {
  margin: 12px 0;
  color: var(--green);
  font-family: "Montserrat", sans-serif;
  font-size: 1.45rem;
}

.about-purpose-panel p {
  line-height: 1.8;
}

.about-purpose-panel-dark {
  background: var(--green);
  color: white;
}

.about-purpose-panel-dark h3,
.about-purpose-panel-dark p {
  color: white;
}

.about-purpose-panel-dark .about-panel-number {
  color: var(--gold);
}

/* Approach */

.about-approach {
  display: grid;
  grid-template-columns: 1fr 0.9fr;
  align-items: center;
  gap: 70px;
  padding: 90px 7%;
  background: var(--ivory);
}

.about-approach-image {
  position: relative;
  min-height: 390px;
  background: #e3dac9;
}

.about-approach-image img {
  display: block;
  width: 100%;
  height: 390px;
  object-fit: cover;
}

.about-approach-image-caption {
  position: absolute;
  right: -20px;
  bottom: 22px;
  max-width: 270px;
  padding: 18px 20px;
  border-left: 4px solid var(--gold);
  background: white;
  color: var(--green);
  font-weight: 700;
  line-height: 1.6;
}

.about-approach-content > p {
  margin-bottom: 18px;
}

/* Values */

.about-values {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 65px;
  padding-top: 85px;
  padding-bottom: 85px;
  background: white;
}

.about-values-heading > p {
  max-width: 430px;
}

.about-values-list {
  border-top: 1px solid #e3ddcf;
}

.about-value-row {
  display: grid;
  grid-template-columns: 44px 0.8fr 1.2fr;
  align-items: start;
  gap: 15px;
  padding: 25px 0;
  border-bottom: 1px solid #e3ddcf;
}

.about-value-number {
  color: #a17c22;
  font-weight: 800;
}

.about-value-row h3 {
  margin: 0;
  color: var(--green);
  font-family: "Montserrat", sans-serif;
  font-size: 1.05rem;
}

.about-value-row p {
  margin: 0;
  color: #514f49;
  line-height: 1.75;
}

/* Leadership */

.about-leadership {
  padding-top: 85px;
  padding-bottom: 85px;
  background: #eee7d8;
}

.about-leadership-heading {
  display: grid;
  grid-template-columns: 1fr 0.8fr;
  align-items: end;
  gap: 55px;
  margin-bottom: 50px;
}

.about-leadership-heading h2 {
  max-width: 620px;
  margin-bottom: 0;
}

.about-leadership-heading > p {
  max-width: 480px;
  margin-bottom: 5px;
}

.about-leadership-group + .about-leadership-group {
  margin-top: 55px;
}

.about-group-heading {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-bottom: 25px;
}

.about-group-index {
  display: grid;
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  place-items: center;
  background: var(--green);
  color: var(--gold);
  font-family: "Montserrat", sans-serif;
  font-weight: 800;
}

.about-group-heading h3 {
  margin: 0 0 5px;
  color: var(--green);
  font-family: "Montserrat", sans-serif;
  font-size: 1.4rem;
}

.about-group-heading p {
  margin: 0;
  color: #5f5b52;
  line-height: 1.6;
}

.about-leaders-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.about-leader-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #e4dccd;
  background: white;
  box-shadow: 0 8px 24px rgba(37, 37, 37, 0.04);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.about-leader-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 15px 30px rgba(37, 37, 37, 0.09);
}

.about-leader-photo {
  position: relative;
  height: 270px;
  overflow: hidden;
  background: #d8d0bf;
}

.about-leader-photo > img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 25%;
}

.about-leader-initials {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  background:
    radial-gradient(circle at 50% 35%, #f7f2e8 0 18%, transparent 18.5%),
    linear-gradient(145deg, #d9d0bd, #bac9bb);
  color: var(--green);
}

.about-leader-initials span {
  display: grid;
  width: 76px;
  height: 76px;
  place-items: center;
  margin-top: 70px;
  border: 3px solid white;
  border-radius: 50%;
  background: var(--green);
  color: var(--gold);
  font-family: "Montserrat", sans-serif;
  font-size: 1.3rem;
  font-weight: 800;
}

.about-leader-initials small {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.15em;
}

.about-profile-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 7px 10px;
  background: white;
  color: var(--green);
  font-size: 0.68rem;
  font-weight: 700;
}

.about-leader-details {
  padding: 24px 22px 26px;
}

.about-leader-role {
  color: #94701d;
  font-size: 0.73rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.about-leader-details h3 {
  margin: 12px 0;
  color: var(--green);
  font-family: "Montserrat", sans-serif;
  font-size: 1.25rem;
  line-height: 1.4;
}

.about-leader-details p {
  margin: 0;
  color: #5a5852;
  font-size: 0.9rem;
  line-height: 1.8;
}

.about-profile-status {
  display: block;
  margin-top: 18px;
  padding-top: 13px;
  border-top: 1px solid #e7e0d4;
  color: #777168;
  font-size: 0.75rem;
}

.about-leadership-disclaimer {
  margin-top: 36px;
  padding: 22px 24px;
  border-left: 4px solid var(--gold);
  background: rgba(255, 255, 255, 0.75);
}

.about-leadership-disclaimer strong {
  color: var(--green);
}

.about-leadership-disclaimer p {
  margin: 8px 0 0;
  color: #5f5b52;
  line-height: 1.8;
}

/* Accountability */

.about-accountability {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  padding-top: 75px;
  padding-bottom: 75px;
  background: white;
}

.about-accountability > div {
  max-width: 750px;
}

.about-accountability h2 {
  margin-bottom: 15px;
}

.about-accountability p {
  margin-bottom: 0;
}

/* Closing call to action */

.about-closing {
  padding: 70px 7%;
  background: var(--green);
  color: white;
  text-align: center;
}

.about-closing .eyebrow {
  color: var(--gold);
}

.about-closing h2 {
  max-width: 850px;
  margin: 20px auto;
  font-family: "Montserrat", sans-serif;
  font-size: clamp(2rem, 3.5vw, 3.25rem);
  line-height: 1.25;
}

.about-closing > p {
  max-width: 650px;
  margin: 0 auto 28px;
  color: #f0ebdf;
  line-height: 1.85;
}

.about-closing-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
}

/* Responsive layouts */

@media (max-width: 1000px) {
  .about-purpose,
  .about-values {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .about-approach {
    gap: 40px;
  }

  .about-leader-photo {
    height: 235px;
  }

  .about-leader-details {
    padding: 20px 16px;
  }
}

@media (max-width: 760px) {
  .about-banner {
    grid-template-columns: 1fr;
  }

  .about-banner-content {
    padding: 55px 7%;
  }

  .about-banner-image {
    min-height: 340px;
  }

  .about-story,
  .about-approach,
  .about-leadership-heading {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .about-story,
  .about-approach {
    padding-top: 60px;
    padding-bottom: 60px;
  }

  .about-section-number {
    display: none;
  }

  .about-purpose-panels {
    grid-template-columns: 1fr 1fr;
  }

  .about-values {
    padding-top: 60px;
    padding-bottom: 60px;
  }

  .about-leaders-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .about-approach-image-caption {
    right: 12px;
    bottom: 12px;
  }
}

@media (max-width: 520px) {
  .about-purpose-panels,
  .about-leaders-grid {
    grid-template-columns: 1fr;
  }

  .about-purpose-panel {
    min-height: auto;
  }

  .about-leader-photo {
    height: 300px;
  }

  .about-value-row {
    grid-template-columns: 36px 1fr;
  }

  .about-value-row p {
    grid-column: 2;
  }

  .about-accountability {
    align-items: flex-start;
    flex-direction: column;
  }

  .about-banner-actions {
    align-items: flex-start;
    flex-direction: column;
  }
}
